---
import MainGridLayout from "@layouts/MainGridLayout.astro";

const title = "你的IP属地";
---

<MainGridLayout title={title}>
  <div
    class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 加载状态 -->
      <div id="loading-state" class="flex flex-col items-center justify-center py-16">
        <div
          class="w-10 h-10 border-4 border-[var(--primary)]/30 border-t-[var(--primary)] rounded-full animate-spin mb-4"
        ></div>
        <p class="text-black/50 dark:text-white/50 text-sm">
          正在通过IP获取你的位置信息...
        </p>
      </div>

      <!-- 结果展示 -->
      <div id="result-state" class="hidden">
        <!-- 身份标识 -->
        <div class="text-center py-8">
          <p class="text-black/40 dark:text-white/40 text-sm mb-3">你的网络IP显示你来自</p>
          <div
            id="identity-display"
            class="text-5xl md:text-6xl font-bold bg-gradient-to-r from-[var(--primary)] to-orange-400 bg-clip-text text-transparent mb-3"
          ></div>
          <div
            id="detail-display"
            class="text-black/50 dark:text-white/50 text-sm space-y-1"
          ></div>
        </div>

        <!-- 分隔线 -->
        <div class="border-t border-[var(--line-divider)] my-6"></div>

        <!-- IP 详情 -->
        <div id="ip-info" class="text-center text-xs text-black/30 dark:text-white/30 space-y-1">
        </div>
      </div>

      <!-- 错误状态 -->
      <div id="error-state" class="hidden text-center py-16">
        <svg
          class="w-12 h-12 mx-auto mb-4 text-black/20 dark:text-white/20"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"
          ></path>
        </svg>
        <p class="text-black/50 dark:text-white/50">位置信息获取失败</p>
        <p class="text-black/30 dark:text-white/30 text-sm mt-2">
          可能是网络问题或广告拦截插件导致，请稍后重试
        </p>
      </div>
    </div>
  </div>
</MainGridLayout>

<script>
  // ─── 中国省份英文名 → 中文名映射表 ───────────────────────────────
  const PROVINCE_MAP: Record<string, string> = {
    Beijing: "北京",
    Tianjin: "天津",
    Shanghai: "上海",
    Chongqing: "重庆",
    Hebei: "河北",
    Shanxi: "山西",
    "Inner Mongolia": "内蒙古",
    Liaoning: "辽宁",
    Jilin: "吉林",
    Heilongjiang: "黑龙江",
    Jiangsu: "江苏",
    Zhejiang: "浙江",
    Anhui: "安徽",
    Fujian: "福建",
    Jiangxi: "江西",
    Shandong: "山东",
    Henan: "河南",
    Hubei: "湖北",
    Hunan: "湖南",
    Guangdong: "广东",
    Guangxi: "广西",
    Hainan: "海南",
    Sichuan: "四川",
    Guizhou: "贵州",
    Yunnan: "云南",
    Tibet: "西藏",
    Shaanxi: "陕西",
    Gansu: "甘肃",
    Qinghai: "青海",
    Ningxia: "宁夏",
    Xinjiang: "新疆",
    "Hong Kong": "香港",
    Macau: "澳门",
    Taiwan: "台湾",
    // 拼音风格（部分API返回拼音）
    beijing: "北京",
    tianjin: "天津",
    shanghai: "上海",
    chongqing: "重庆",
    hebei: "河北",
    shanxi: "山西",
    liaoning: "辽宁",
    jilin: "吉林",
    heilongjiang: "黑龙江",
    jiangsu: "江苏",
    zhejiang: "浙江",
    anhui: "安徽",
    fujian: "福建",
    jiangxi: "江西",
    shandong: "山东",
    henan: "河南",
    hubei: "湖北",
    hunan: "湖南",
    guangdong: "广东",
    guangxi: "广西",
    hainan: "海南",
    sichuan: "四川",
    guizhou: "贵州",
    yunnan: "云南",
    xizang: "西藏",
    shaanxi: "陕西",
    gansu: "甘肃",
    qinghai: "青海",
    ningxia: "宁夏",
    xinjiang: "新疆",
    neimenggu: "内蒙古",
  };

  function getProvinceCN(region: string): string | null {
    if (!region) return null;
    const trimmed = region.trim();
    // 直接匹配
    if (PROVINCE_MAP[trimmed]) return PROVINCE_MAP[trimmed];
    // 尝试去除 " Province" / " City" / " Sheng" 等后缀再匹配
    const cleaned = trimmed
      .replace(/\s*(Province|City|Sheng|Shi|Municipality|Autonomous Region|Special Administrative Region|SAR)\s*$/i, "")
      .trim();
    if (PROVINCE_MAP[cleaned]) return PROVINCE_MAP[cleaned];
    // 如果region本身已经是中文，直接返回
    if (/[一-鿿]/.test(trimmed)) {
      return trimmed.replace(/省|市|自治区|特别行政区/g, "");
    }
    return null;
  }

  // ─── DOM 元素 ─────────────────────────────────────────────────
  const loadingEl = document.getElementById("loading-state")!;
  const resultEl = document.getElementById("result-state")!;
  const errorEl = document.getElementById("error-state")!;
  const identityEl = document.getElementById("identity-display")!;
  const detailEl = document.getElementById("detail-display")!;
  const ipInfoEl = document.getElementById("ip-info")!;

  function showResult() {
    loadingEl.classList.add("hidden");
    resultEl.classList.remove("hidden");
    errorEl.classList.add("hidden");
  }

  function showError() {
    loadingEl.classList.add("hidden");
    resultEl.classList.add("hidden");
    errorEl.classList.remove("hidden");
  }

  // ─── IP 地理定位 API（按优先顺序尝试）─────────────────────────
  interface GeoData {
    ip: string;
    country: string;
    province: string | null; // 中文省份名
    city: string | null;
    isp: string | null;
  }

  async function tryApi1(): Promise<GeoData | null> {
    // api.ip.sb — 速度快、支持好，返回英文省份名
    const res = await fetch("https://api.ip.sb/geoip", {
      headers: { Accept: "application/json" },
    });
    if (!res.ok) return null;
    const d = await res.json();
    if (!d.ip) return null;
    const country = d.country || d.country_code || "";
    const provinceEn = d.region || "";
    const provinceCN = getProvinceCN(provinceEn);
    return {
      ip: d.ip,
      country,
      province: provinceCN || provinceEn || null,
      city: d.city || null,
      isp: d.isp || d.organization || null,
    };
  }

  async function tryApi2(): Promise<GeoData | null> {
    // api.vore.top — 直接返回中文省份
    const res = await fetch("https://api.vore.top/api/IPdata", {
      headers: { Accept: "application/json" },
    });
    if (!res.ok) return null;
    const d = await res.json();
    if (d.code !== 200 || !d.ipdata) return null;
    const ipd = d.ipdata;
    const provinceFromAPI = ipd.info1 || "";
    const cityFromAPI = ipd.info2 || "";
    return {
      ip: ipd.ip || "",
      country: ipd.info0 || "",
      province: provinceFromAPI || null,
      city: cityFromAPI || null,
      isp: ipd.isp || null,
    };
  }

  async function tryApi3(): Promise<GeoData | null> {
    // api.ipapi.is — 备选
    const res = await fetch("https://api.ipapi.is/", {
      headers: { Accept: "application/json" },
    });
    if (!res.ok) return null;
    const d = await res.json();
    if (!d.ip) return null;
    const provinceEn = d.region || d.state || "";
    const provinceCN = getProvinceCN(provinceEn);
    return {
      ip: d.ip,
      country: d.country || d.country_code || "",
      province: provinceCN || provinceEn || null,
      city: d.city || null,
      isp: d.isp || d.asn || null,
    };
  }

  async function tryApi4(): Promise<GeoData | null> {
    // ipapi.co — 最后的备选
    const res = await fetch("https://ipapi.co/json/");
    if (!res.ok) return null;
    const d = await res.json();
    if (d.error || !d.ip) return null;
    const provinceEn = d.region || "";
    const provinceCN = getProvinceCN(provinceEn);
    return {
      ip: d.ip,
      country: d.country_name || d.country || "",
      province: provinceCN || provinceEn || null,
      city: d.city || null,
      isp: d.org || null,
    };
  }

  // ─── 主逻辑 ──────────────────────────────────────────────────
  async function detectLocation() {
    const apis = [tryApi1, tryApi2, tryApi3, tryApi4];

    for (const apiFn of apis) {
      try {
        const data = await apiFn();
        if (data) {
          renderResult(data);
          return;
        }
      } catch {
        // 尝试下一个 API
        continue;
      }
    }

    // 所有 API 都失败
    showError();
  }

  function renderResult(data: GeoData) {
    showResult();

    // 确定身份标识文本
    let identityText: string;
    if (data.province) {
      // 有省份信息 → "XX人"
      const name = data.province.replace(/省|市|自治区|特别行政区|壮族|回族|维吾尔/g, "");
      identityText = name + "人";
    } else if (data.country === "China" || data.country === "CN" || data.country === "中国") {
      identityText = "中国人";
    } else if (data.country) {
      // 国外用户，显示国家名 + 人
      identityText = data.country + "人";
    } else {
      identityText = "地球人 🌍";
    }

    identityEl.textContent = identityText;

    // 详细信息
    let detailHTML = "";
    if (data.city && data.province) {
      detailHTML += `<p>${data.province} · ${data.city}</p>`;
    } else if (data.province) {
      detailHTML += `<p>${data.province}</p>`;
    } else if (data.city) {
      detailHTML += `<p>${data.city}</p>`;
    }
    if (data.country) {
      detailHTML += `<p>${data.country}</p>`;
    }
    detailEl.innerHTML = detailHTML;

    // IP 信息
    let ipHTML = "";
    if (data.ip) {
      ipHTML += `<p>IP: ${data.ip}</p>`;
    }
    if (data.isp) {
      ipHTML += `<p>运营商: ${data.isp}</p>`;
    }
    ipInfoEl.innerHTML = ipHTML;
  }

  // ─── 启动 ────────────────────────────────────────────────────
  detectLocation();
</script>
